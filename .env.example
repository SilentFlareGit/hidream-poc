# Phase 1 runtime configuration.
# This URL is validated by setup-comfyui.sh and must not be changed.
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
# Required: replace this with a reviewed 40-character upstream commit ID.
COMFYUI_COMMIT=
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_ALLOW_NON_LOOPBACK=0
# Leave blank to prefer Vast's /venv/main/bin/python automatically.
# Set an explicit executable only when intentionally overriding that choice.
COMFYUI_PYTHON=

# Phase 2 uses config/models.json and stores model files under the pinned
# ComfyUI checkout. Source and SHA-256 values are manifest-pinned; Python
# dependency resolution remains governed by the pinned checkout requirements.
# The RTX 5090 target needs CUDA 12.8 compatibility and PyTorch >= 2.7.
# Run scripts/check-host.sh and require its real CUDA operation to pass first.

# Runtime state is kept under the repository but ignored by Git.
COMFYUI_RUNTIME_DIR=.runtime
COMFYUI_DIR=.runtime/comfyui
COMFYUI_LOG_DIR=.runtime/logs
COMFYUI_PID_FILE=.runtime/comfyui.pid
COMFYUI_LOG_FILE=.runtime/logs/comfyui.log

# Used only to print the SSH tunnel command. Replace the host and port with
# the connection details shown by Vast.ai.
SSH_TUNNEL_HOST=YOUR_VAST_SSH_HOST
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=root
SSH_LOCAL_PORT=8188
